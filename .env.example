# Copy to .env.local for local dev (gitignored via *.local). Deployed builds
# read these from the hosting platform's secrets, not from this file.
# The committed .env holds only publishable VITE_* values.

# --- Server-only secrets (never prefix with VITE_) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_ID=

# AI: Gemini first, second key takes over on quota errors, Lovable gateway as fallback
GEMINI_API_KEY=
GEMINI_API_KEY_2=
LOVABLE_API_KEY=

# Maps and places
MAPBOX_TOKEN=
GEOAPIFY_KEY=

# Comma-separated auth user IDs allowed to run the RLS self-check in production
SECURITY_CHECK_USER_IDS=
