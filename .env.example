# Copy to .env.local for local dev (gitignored via *.local). Deployed builds
# read these from the hosting platform's secrets, not from this file.
# The committed .env holds only publishable VITE_* values.

# --- Server-only secrets (never prefix with VITE_) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_ID=

# AI: each feature runs down a strong or light model chain across every key below
# (see TIER_CHAIN in src/lib/ai-gateway.server.ts). Up to _5 per provider, each its
# own free-tier project. Lovable gateway is used only when no Gemini/Groq key is set.
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GROQ_API_KEY=
GROQ_API_KEY_2=
LOVABLE_API_KEY=

# Maps and places
MAPBOX_TOKEN=
GEOAPIFY_KEY=

# Comma-separated auth user IDs allowed to run the RLS self-check in production
SECURITY_CHECK_USER_IDS=

# Email second-factor delivery (server-only; never use VITE_ prefixes)
RESEND_API_KEY=
AUTH_EMAIL_FROM=
# Generate a random secret of at least 32 bytes. Rotating invalidates pending codes.
AUTH_OTP_SECRET=

# Set only after verifying ALL configured AI providers/fallbacks exclude training
# on submitted user data, including account tier, retention and DPA settings.
AI_DATA_PROCESSING_APPROVED=false
